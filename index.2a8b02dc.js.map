"use strict";
var tablet = document.querySelectorAll(".field");
tablet.forEach(function(table) {
    var input = table.querySelector("input");
    var nameCell = document.createElement("label");
    var inputId = input.id;
    var inputPlaceholder = input.name;
    nameCell.textContent = input.name;
    nameCell.setAttribute("for", inputId);
    input.setAttribute("placeholder", inputPlaceholder);
    nameCell.classList.add("field-label");
    input.insertAdjacentElement("beforebegin", nameCell);
});
var loginForm = document.querySelectorAll("form")[1];
loginForm.addEventListener("submit", function(e) {
    e.preventDefault();
    var email = document.getElementById("sign-in-email").value.trim();
    var password = document.getElementById("sign-in-password").value.trim();
    if (email === "" || password === "") alert("Please fill in all fields");
    else alert("Login successfully");
    var signUpForm = document.querySelectorAll("form")[0];
    signUpForm.style.display = "none";
    var signInForm = document.querySelectorAll("form")[1];
    signInForm.style.display = "block";
});
window.addEventListener("load", function() {
    var signUpForm = document.querySelectorAll("form")[0];
    signUpForm.style.display = "none";
    var signInForm = document.querySelectorAll("form")[1];
    signInForm.style.display = "block";
});

